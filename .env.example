# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only authentication session tokens.
SESSION_SECRET="replace-with-a-strong-random-32-char-secret"

# DATA_ENCRYPTION_KEY: Secret used to derive the AES-256-GCM encryption key for sensitive reports & 2FA secrets.
DATA_ENCRYPTION_KEY="replace-with-a-strong-random-32-char-encryption-key"

# OWNER_NOTIFICATION_EMAIL: Website owner email for security and account notifications.
OWNER_NOTIFICATION_EMAIL="support@dnageneie.com"

# Option A: Resend Email Service (Recommended)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DNA GENEIE Security <notifications@dnageneie.com>"

# Option B: SMTP Email Service (Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DNA GENEIE Security <notifications@dnageneie.com>"

# Authorized Owner Administrator Credentials (strictly support@dnageneie.com)
OWNER_ADMIN_EMAIL="support@dnageneie.com"
ADMIN_PASSWORD=""

# WhatsApp Support Number (digits with country code, official: 919023294189)
VITE_WHATSAPP_NUMBER="919023294189"
